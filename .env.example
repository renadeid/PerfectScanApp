# Postgres connection string.
#
# If you create a Postgres database from the Vercel dashboard (your
# project -> Storage -> Create Database -> Postgres, powered by Neon),
# Vercel injects DATABASE_URL into your project automatically and you do
# NOT need to set this by hand in production.
#
# For local development, copy this file to .env and paste a connection
# string here (a local Postgres, or a free Neon/Supabase database).
DATABASE_URL="postgres://user:password@localhost:5432/perfectscan"
